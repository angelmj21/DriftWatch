# Copy to .env and fill in. NEVER commit .env or real keys.
# ---- backend (owner: Angel, see backend/app/config.py) ----
DW_LOG_PATH=./logs/hospital.log
DW_LABELS_PATH=./logs/labels.jsonl
DW_WINDOW_SHORT_S=60
DW_WINDOW_LONG_S=300
DW_SENSITIVITY=3.0
AWS_REGION=ap-south-1
DW_SNS_TOPIC_ARN=
DW_CW_LOG_GROUP=/driftwatch/alerts
DW_CW_METRIC_NAMESPACE=DriftWatch
# AWS credentials come from `aws configure` or the standard AWS_* env vars, not from this repo
DW_ALLOWED_LATENESS_S=5
DW_TAILER_POLL_INTERVAL_S=0.2
DW_WS_METRIC_INTERVAL_S=1
DW_WS_HEARTBEAT_S=10
DW_API_PORT=8000
DW_CONTROL_PORT=8001
DW_BASELINE_MIN_SAMPLES=120
DW_BASELINE_HISTORY_LEN=900
DW_EWMA_ALPHA=0.05
DW_MIN_SCALE=0.5
DW_MIN_EVENTS_PER_WINDOW=20
DW_FREEZE_MAX_S=1800
DW_Z_ON=4.0
DW_Z_SOFT=2.5
DW_Z_OFF=1.5
DW_SLOPE_ON=0.5
DW_ON_TICKS=3
DW_OFF_TICKS=10
DW_SLOPE_WINDOW_S=120
DW_SIG_MIN_COUNT=3
DW_SIG_SHIFT_RATIO=5.0
DW_SEV_WARN_SCORE=0.35
DW_SEV_CRITICAL_SCORE=0.65
DW_COOLDOWN_S=120
DW_UPDATE_INTERVAL_S=15
DW_RESOLVE_AFTER_S=30
DW_SNS_MIN_SEVERITY=WARN
# ---- frontend (owner: Ayush) ----
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
VITE_CONTROL_URL=http://localhost:8001
